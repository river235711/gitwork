#!/bin/bash
#==============================================================================
# cgui  -- launcher (bash)
#
# This script can be moved to any directory; it does not have to sit next to
# cgui.bin / cgui.py. Put it on PATH (or make an alias) and just type:  cgui
#
# Order for locating the cgui install directory:
#   1. cgui.bin or cgui.py sitting next to this script (highest priority: a
#      full-path run always runs the app beside it, unaffected by a stray
#      CGUI_HOME)
#   2. environment variable $CGUI_HOME
#   3. the built-in DEFAULT_HOME below
#
# Execution mode:
#   - If $HOME_DIR/cgui.bin exists and is executable (Nuitka native ELF build),
#     launch it directly with zero Python / module-load overhead.
#   - Otherwise run $HOME_DIR/cgui.py using a tkinter-capable python.
#
# License environment variable:
#   CTMP_LICENSE_FILE      path to ctmp.lic (or $HOME_DIR/ctmp.lic)
#
# Overridable environment variables:
#   CGUI_HOME     directory containing cgui.bin / cgui.py
#   CGUI_MODULE   python to module-load (default python/3.6.3)
#   CGUI_PYTHON   python executable to use directly (skips module-load detection)
#
# Usage:
#   cgui           the full window, on the tab it was last left on
#   cgui -l        the machine chooser only (LOADING on its own)
#   cgui -e ...    engineer mode: command-line tools (foreground)
#   cgui -L        show license status/details (foreground)
#   cgui --help    the option list
#==============================================================================

# --- Built-in default install path (used when $CGUI_HOME is unset and the
#     script is not next to the app) ------------------------------------------
DEFAULT_HOME="/home/willhuang/work/gitwork/python/cgui"

# --- 1. Resolve this script's real directory (following symlinks) ------------
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
    _dir="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
    SOURCE="$(readlink "$SOURCE")"
    [[ "$SOURCE" != /* ]] && SOURCE="$_dir/$SOURCE"
done
SELFDIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"

# --- 2. Decide which directory holds cgui.bin / cgui.py ----------------------
if [ -x "$SELFDIR/cgui.bin" ] || [ -f "$SELFDIR/cgui.py" ]; then
    HOME_DIR="$SELFDIR"
elif [ -n "$CGUI_HOME" ]; then
    HOME_DIR="$(cd "$CGUI_HOME" 2>/dev/null && pwd || printf '%s' "$CGUI_HOME")"
else
    HOME_DIR="$DEFAULT_HOME"
fi

CGUI_BIN="$HOME_DIR/cgui.bin"
CGUI_PY="$HOME_DIR/cgui.py"

# --- 3. Fast path: compiled Nuitka native binary -----------------------------
if [ -x "$CGUI_BIN" ]; then
    case "${1:-}" in
        -e|--engineer|-h|--help|-L|--license|--license-info)
            exec "$CGUI_BIN" "$@"
            ;;
    esac
    "$CGUI_BIN" "$@" &
    echo "cgui started in the background (PID $!, binary: $CGUI_BIN)"
    exit 0
fi

# --- 4. Fallback: source checkout via Python + tkinter -----------------------
if [ ! -f "$CGUI_PY" ]; then
    echo "cgui: main program not found: $CGUI_BIN or $CGUI_PY" >&2
    echo "      Set CGUI_HOME to the directory containing cgui, e.g.:" >&2
    echo "        export CGUI_HOME=/path/to/cgui" >&2
    exit 1
fi

find_python() {
    for _c in "$CGUI_PYTHON" python3 python; do
        [ -n "$_c" ] || continue
        if "$_c" -c 'import tkinter' >/dev/null 2>&1; then
            PY="$_c"
            return 0
        fi
    done
    return 1
}

PY=""
if ! find_python; then
    if ! type module >/dev/null 2>&1; then
        for _init in "$MODULESHOME/init/bash" \
                     /usr/share/Modules/init/bash \
                     /etc/profile.d/modules.sh \
                     /usr/share/lmod/lmod/init/bash; do
            if [ -f "$_init" ]; then
                source "$_init"
                break
            fi
        done
    fi

    CGUI_MODULE="${CGUI_MODULE:-python/3.6.3}"
    if type module >/dev/null 2>&1; then
        if [ "${CGUI_MODULE_PURGE:-1}" != "0" ]; then
            module purge      >/dev/null 2>&1
        fi
        module load "$CGUI_MODULE" >/dev/null 2>&1
    fi
    find_python
fi

if [ -z "$PY" ]; then
    echo "cgui: no python with a built-in tkinter found." >&2
    echo "      - Check the module name (currently: $CGUI_MODULE), or use" >&2
    echo "        export CGUI_MODULE=python/<version>  to pick another one" >&2
    echo "      - Or point directly at a tkinter-capable python:" >&2
    echo "          export CGUI_PYTHON=/path/to/python3" >&2
    echo "      - Or install it:  sudo yum install python3-tkinter" >&2
    exit 1
fi

if [ "${CGUI_TIMING:-0}" != "0" ] && [ -n "${SECONDS:-}" ]; then
    printf '[cgui] %-34s %6.1f ms\n' "launcher (find python)" \
        "$(awk "BEGIN{print $SECONDS * 1000}")" >&2
fi

case "${1:-}" in
    -e|--engineer|-h|--help|-L|--license|--license-info)
        exec "$PY" "$CGUI_PY" "$@"
        ;;
esac

"$PY" "$CGUI_PY" "$@" &
echo "cgui started in the background (PID $!, python: $PY)"

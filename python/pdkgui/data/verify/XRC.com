LAYOUT PRIMARY "top"
LAYOUT PATH "./top.gds"
LAYOUT SYSTEM GDSII

SOURCE PRIMARY "top"
SOURCE PATH "./top.cdl"
SOURCE SYSTEM SPICE

PEX REPORT "pex.rep"

//LVS BOX
include ./XRC_calibre/typical/rules

PEX PIN ORDER SOURCE
PEX REDUCE VIA RESISTANCE off

//***modify ground name***//
PEX NETLIST DISTRIBUTED "top.dist" SPECTRE SOURCE GROUND GND MASK DIRECT LOCATION
PEX NETLIST LUMPED "top.lump" SPECTRE SOURCE GROUND GND MASK DIRECT LOCATION
PEX NETLIST SIMPLE "top.simple" SPECTRE SOURCE MASK DIRECT LOCATION

include ./DFM_LVS_RC_deck
